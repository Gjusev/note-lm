{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "note-lm",
  "version": "0.1.0",
  "identifier": "com.notelm.spike",
  "build": {
    "frontendDist": "../src/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "note-lm",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/note-lm/**"]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/engine/**/*",
      "resources/ffmpeg/**/*",
      "resources/llama/**/*",
      "resources/samples/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ]
  }
}