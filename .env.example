# note-lm — lokale Konfiguration (alles optional außer den KI-Schlüsseln,
# wenn man KI-Funktionen nutzen will)

# Datenverzeichnis (Standard: OS-Nutzerdatenverzeichnis, außerhalb des Repos)
# NOTELM_DATA_DIR=C:\Users\du\note-lm-data

# Port des lokalen Servers (Standard 3128 beim Launcher)
# NOTELM_PORT=3128

# Anzeigename des lokalen Profils
# NOTELM_USER_NAME=Lokales Profil

# ── KI (optional) ───────────────────────────────────────────────────────────
# OpenAI-kompatibel: Chat, Transkription, Podcast-TTS. Ohne Schlüssel starten
# Notizbücher, Quellen, Import und lokale Suche trotzdem.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE_HOST_1=alloy
# OPENAI_TTS_VOICE_HOST_2=echo

# Azure OCR — nur für gescannte PDFs ohne Textebene (optional)
# AZURE_OCR_ENDPOINT=
# AZURE_OCR_KEY=

# ── Websuche (optional) ─────────────────────────────────────────────────────
# SearXNG-Endpunkt für die Websuche; ohne ihn funktioniert nur die
# Notizbuch-interne Suche.
# SEAR_ENDPOINT=

# ── Import-Worker ────────────────────────────────────────────────────────────
# INGEST_POLL_MS=3000
# INGEST_MAX_AUDIO_MB=50
# INGEST_MAX_VIDEO_MB=250
# INGEST_DISABLE_YOUTUBE=0
